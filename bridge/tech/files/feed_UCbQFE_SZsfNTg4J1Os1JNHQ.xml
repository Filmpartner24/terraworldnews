  <title>Office Hours with Nathalie Pinkerton: Targeting Oral Cancer Pain with Nanomedicine</title>
  <link rel="alternate" href="https://www.youtube.com/watch?v=RyPUu0U4uvg"/>
  <author>
   <name>NYU Tandon School of Engineering</name>
   <uri>https://www.youtube.com/channel/UCbQFE_SZsfNTg4J1Os1JNHQ</uri>
